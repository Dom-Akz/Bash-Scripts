#!/usr/bin/env bash

# generate / verifez checksum (mini version)

declare -r sname="chsum"
declare -r manifest="$(pwd)/manifest"
declare -r logpath="$HOME/.local/share/checksum/chechsum-log-$(date +%d-%m-%y).log"

# load messages lib
declare LIBRARY=${LIBRARY:-'/usr/share/makepkg'}
source "$LIBRARY"/util/message.sh

log() {
	[[ ! -e "$logpath" ]] && touch "$logpath"
	echo -e "$1" >>"$logpath"
}

die() {
	colorize
	error "$1"
	log "[$(date)]: Error $1"
	exit 1
}

usage() {
	cat <<EOF
Usage ${sname} <checksum> <filename> [OPTIONS]

Options:

  -h: display this help 
  -c <filename>: verfiez file checksum

Note:
  you can view log here: ${logpath} 
  you can see all metadata in file called 'manifest' this file will have this structer <checksum> <filename> <hash-algorithm>
  make sure you don't edit the 'hash algorithm' in manifest or the verification will failed
  Use only this hash algorithm: sha-1, sha-256, sha-512 

EOF
}

gene_ch() {
	local filename="$1"
	local l_num=0
	local checksum_file=""$filename"."$hash_algo""

	local out=$("$hash_algo" "$filename")
	local output="$out"" ""$hash_algo"
	echo "$output"
	touch "$checksum_file"
	log "[$(date)]: created new checksum file: $checksum_file"

	l_num=$(cat "$manifest" | grep -n "$filename" | cut -d: -f1)
	if [[ $l_num -ne 0 ]]; then
		sed -i "${l_num}s/.*/${output}/" "$filename"
	else
		echo "$output" >>"$manifest"
	fi

	local checksum=$(echo "$out" | awk '{print $1}')
	echo "$checksum" >>$checksum_file

	log "[$(date)]: created new checksum for: $filename"

	echo "$checksum $filename"
}

create_checksum() {
	# check if the hash algo exsist
	if ! type -p "$hash_algo" &>/dev/null; then
		die "$has_aglo command not found (try installing the pkg:)"
	fi

	# one file
	if [ -e "$path" ]; then
		gene_ch "$path"
		# dir
	elif [ -d "$path" ]; then
		log "[$(date)]: start creating checksum for all file inside directory: $path"
		find "$path" -maxdepth 1 -type f | while IFS= read -r file; do
			gene_ch "$file"
		done
	else
		die "'$path' not found"
	fi

}

# given file verifez the old checksum (in manifest file) with the new hash
# return Ok (match) - Diff (don't match) - FAIELD (old checksum not found)
verify_checksum() {
	local old_checksum=""
	local checksum_file=""
	local hash_algo=""

	# check if the file exsist in manifest
	checksum_file=$(cat "$manifest" | grep "$path")
	[[ -z "$checksum_file" ]] && die "verification FAILED, file not found in $manifest"

	old_checksum=$(echo $checksum_file | awk '{print $1}')
	hash_algo=$(echo $checksum_file | awk '{print $3}')
	if [ $hash_algo != "sha256sum" ] && [ $hash_algo != "sha1sum" ] && [ $hash_algo != "sha512sum" ]; then
		die "hash algorithm not found in $manifest"
	fi

	# genereate checksum using the same hash_algo found in manifest
	new_checksum=$("$hash_algo" "$path" | awk '{print $1}')
	if [ $new_checksum == $old_checksum ]; then
		echo "Ok"
	else
		echo "Diff"
	fi

}

main() {
	log "[$(date)]: $(whoami) run the script"
	local verf=0
	local verf_file=""
	while getopts "hc:" opt; do
		case "$opt" in
		h)
			help
			exit 0
			;;
		c)
			verf=1
			verf_file="$OPTARG"
			;;
		\*)
			die "Invalid options (use $sname -h for help)"
			;;
		esac

	done

	if [ $verf == 1 ]; then
		[[ -d $verf_file ]] && die "expect file found a directory: $verf_file"
		verify_checksum $verf_file
		exit 0
	fi

	shift $((OPTIND - 1))

	# global variable
	hash_algo="$1"
	path="$2"

	[[ -z "$path" ]] || [[ -z "$hash_algo" ]] && die "not enugh arguments (see $sname -h)"

	case "$hash_algo" in
	'sha1')
		hash_algo="sha1sum"
		;;
	'sha256')
		hash_algo="sha256sum"
		;;
	'sha512')
		hash_algo="sha512sum"
		;;
	\*)
		die "hash aglorithm not in (sha1, sha256, sha512)"
		;;
	esac

	[[ ! -e "$manifest" ]] && {
		touch $manifest
		log "[$(date)]: create manifest file: $manifest"
	}

	if [ -d "$path" ]; then
		[[ -z "$(ls -A "$path")" ]] && die "$path is empty"
	fi

	if [ $verf == 1 ]; then
		[[ -d $path ]] && die "expect file found a directory: $path"
		verify_checksum
	else
		create_checksum
	fi
}

main "$@"
