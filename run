#!/bin/bash
# ==========================================
# arch-sync Project Structure Generator
# Creates a complete scaffold for a multi-part Arch Linux tool
# ==========================================

set -e

PROJECT_NAME="arch-sync"

echo "Creating project structure for $PROJECT_NAME..."

# Root folders
mkdir -p $PROJECT_NAME/{cli/{src,tests},backend,web/src/{pages,components},docs,scripts,.github/workflows}

# CLI files
touch $PROJECT_NAME/cli/{Cargo.toml,PKGBUILD,README.md}
touch $PROJECT_NAME/cli/src/{main.rs,config.rs,packages.rs,api.rs,backup.rs}
touch $PROJECT_NAME/cli/tests/integration_test.rs

# Backend files
touch $PROJECT_NAME/backend/{main.py,requirements.txt,database.py,auth.py,storage.py}

# Web files
touch $PROJECT_NAME/web/{package.json,README.md}
touch $PROJECT_NAME/web/src/{App.tsx}
touch $PROJECT_NAME/web/src/pages/{Dashboard.tsx,Backups.tsx,Settings.tsx}

# Docs
touch $PROJECT_NAME/docs/{getting-started.md,api-reference.md,architecture.md,faq.md}

# Scripts
touch $PROJECT_NAME/scripts/{deploy.sh,test-integration.sh,seed-demo-data.py}

# GitHub Actions
touch $PROJECT_NAME/.github/workflows/{test.yml,release.yml}

# Root files
touch $PROJECT_NAME/{LICENSE,README.md,CONTRIBUTING.md}

