#!/bin/bash

package=$1

sudo pacman -Si $package 2>/dev/null >/dev/null

if [ $? -eq 0 ]
then
    echo "runnig with pacman..."
    sudo pacman -S $package


if [ $(yay -Si $package >/dev/null)  $? -eq 0 ]
then
    echo "running with yay..."
    yay -S $package
else
    echo -e "\e[31m$package dose not exist\e[0m"
fi


