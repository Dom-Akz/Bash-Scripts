#!/bin/bash

# if the package is installed fetch for update
# if there is no update do nothing

package=$1

sudo pacman -Si "$package" 2>/dev/nul

if [ $? -eq 0 ]; then
	echo "runnig with pacman..."
	sudo pacman -S "$package"
	exit 0
fi

$(yay -Si "$package" 2>/dev/null)

if [ $? -eq 0 ]; then
	echo "running with yay..."
	yay -S "$package"
	exit 0
else
	echo -e "\e[31m "$package" dose not exist\e[0m"
	exit 1
fi
