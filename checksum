#!/usr/bin/env bash

# generate / verifez checksum

declare -r sname="checksum"
declare -r manifest="$(pwd)/manifest"
declare -r logpath="$HOME/.local/share/checksum/chechsum-log-$(date +%d-%m-%y).log"

# load messages lib
declare LIBRARY=${LIBRARY:-'/usr/share/makepkg'}
source "$LIBRARY"/util/message.sh

log() {
    [[ ! -e "$logpath" ]] && touch "$logpath"
    echo -e "$1" >>"$logpath"
}

die() {
    colorize
    error "$1"
    log "[$(date)]: $1"
    exit 1
}

help() {
    cat <<EOF
Usage ${sname} <checksum> <filename> [OPTIONS]

Options:

  -h: display this help 
  -c <filename>: verfiez file checksum

Note:
  you can view log here: ${logpath} 
  use only this hash algorithme: sha-1, sha-256, sha-512 

EOF
}

generate() {
    local hash_algo=$1
    local path=$2
    local checksum=""

    # check if the hash algo exsist
    if ! type -p "$hash_algo" &>/dev/null; then
        die "$has_aglo command not found"
    fi

    # one file
    if [ -a "$path" ]; then
        "$hash_algo" $path >>"$manifest" # hash_algo hold the command ex: sha256sum
        checksum=$(cat "$manifest" | grep -E "$path" | awk '{print $1}')
        log "[$(date)]: created new checksum for: $path"
        echo "$checksum $path"
    # dir
    elif [ -d "$path" ]; then
        log "[$(date)]: start creating checksum for all file inside directory: "$path""
        for file in $(find "$path" -maxdepth 1 -type f); do
            "$hash_algo" "$file" >>"$manifest"
            checksum=$(cat $manifest | grep -E "$file" | awk '{print $1}')
            log "[$(date)]: created new checksum for: $path"
            echo "$checksum $file"
        done
    fi

}

# verfiez() {}

main() {
    verf=0

    while getopts "hc:" opt; do
        case "$opt" in
        h)
            help
            exit 0
            ;;
        c)
            verf=1
            ;;
        \*)
            die "Invalid options (use $sname -h for help)"
            ;;
        esac

    done

    shift $((OPTIND - 1))

    hash_algo="$1"
    filename="$2"

    # check if hash_algo is valid

    case "$hash_algo" in
    'sha1')
        hash_algo="sha1sum"
        ;;
    'sha256')
        hash_algo="sha256sum"
        ;;
    'sha512')
        hash_algo="sha512sum"
        ;;
    \*)
        die "hash aglorithme not in (sha1, sha256, sha512)"
        ;;

    esac

    [[ ! -e "$manifest" ]] && {
        touch $manifest
        log "[$(date)]: create manifest file: $manifest"
    }

    # check if file exsist
    generate $hash_algo $filename

}

main "$@"
