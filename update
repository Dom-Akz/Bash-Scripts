#!/bin/bash


# -S = Sync packages.
# -y = Refresh the package database (only if it's outdated).
# -u = Upgrade all installed packages.
# -Syy = Forcefully download the package database for all repositories, even if it appears up to date.
# add the choice to run yay -Syu

checkExitCode(){
    if [ $? -eq 1 ]
    then
        echo -e "       -- \e[31m$1 \e[0m     --"
        exit
    else
        echo "      -- the $1 run whitout error     -- "
    fi
}


sudo pacman -Syu
checkExitCode "(sudo pacman -Syu)"

yay -Syu
checkExitCode "(yay -Syu)"

sudo pacman -Sc
checkExitCode "(sudo pacman -Sc)"

