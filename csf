#!/usr/bin/env bash

declare -r user=$(whoami)
declare -r sname='csf'

declare LOCATION="$HOME"/.local/bin/
declare LIBRARY=${LIBRARY:-'/usr/share/makepkg'}

source "$LIBRARY"/util/message.sh

declare -i OPEN=0

die() {
	colorize
	error "$1"
	exit 1
}

usage() {
	cat <<EOF
Usage ${sname} [options] filename

Options:
  -h, --help		displaydisplay this help
  -o, --open		open file in vim or neovim
  -l, --location	file location

Default Value:
  default directory is: /home/${user}/.local/bin/
  default file extensions: bash (if the given file has no specify extensions)

Hint:
  if you create a c/c++ file it will be compile and will found the executable with the same name as the file

EOF
}
# add .sh
handle_ext() {
	local ext=$1
	local path=$2
	local outfile=$(basename "$path" ".""$ext") # compile file name
	# for any other extension the file will be empty
	case "$ext" in
	'py')
		printf "print('script created')" >"$path"
		;;
	'c')
		echo -e '#include<stdio.h>\nint main(){\n\tprintf("file created");\n\treturn 0;\n}' >"$path"
		# compile
		gcc "$path" -o "$outfile" 2>/dev/null
		;;
	'cpp')
		echo -e '#include<iostream>\n\nint main(){\n\tstd::cout << "file created";\n\treturn 0;\n}' >"$path"
		# compile
		g++ "$path" -o "$outfile" out 2>/dev/null
		;;
	esac
}

handle_file() {
	local full_name="$1"
	local filename="$2"
	local ext=""
	if [ -f "$1" ]; then
		die "File exist! (try different name)"
	fi

	touch "$full_name"

	# handle extension
	# check if the filename containe a extension
	printf "$filename" | grep "\.[a-zA-Z0-9]\+$" >/dev/null

	if [ $? -eq 0 ]; then
		ext=$(printf "$filename" | cut -d'.' -f2) # extract the extensions
		handle_ext $ext $full_name

	# default extensions
	else
		echo -e "#!/usr/bin/env bash" "\necho 'script created'" >"$ff"
	fi

	# skip if the file is c/c++
	if [ "$ext" != 'c' ] || [ "$ext" != 'cpp' ]; then
		# check if the user is root and make the file executable
		if [ $(ls -ld "$full_name" | awk '{print $3}') != "root" ]; then
			chmod +x "$full_name"
		else
			sudo chmod +x "$full_name"
		fi

		# open the file
		if [ $OPEN -eq 1 ]; then
			if type -P nvim >/dev/null 2>&1; then
				nvim "$full_name"
			else
				vim "$full_name"
			fi
		fi
	fi
}

while getopts "ohl:" opt; do
	case "$opt" in
	o)
		OPEN=1
		;;
	l)
		LOCATION="$OPTARG""/"
		;;
	h)
		usage
		exit 0
		;;
	\*)
		die "Invalid option -$opt (use -h for help)"
		;;
	esac
done

shift $((OPTIND - 1))

filename="$1"

if [ -z "$filename" ]; then
	die "No file nam was given (use -h for help)"
fi

if [ ! -d $LOCATION ]; then
	echo "$LOCATION No such file or directory"
	exit 1
fi

ff="$LOCATION""$filename"

# all the steps are been handle by this function
handle_file $ff $filename
