#!/bin/bash

activework_space=$(hyprctl workspaces -j | jq ".[].id") # output : 1 2 3 ...

$(echo "$activework_space" | grep -qwc 1)
if [ $? -eq 1 ]; then
	hyprctl dispatch workspace 1 -q
	exit 0
fi

for val in $activework_space; do
	mp=$((val + 1))
	$(echo $activework_space | grep -qwc "$mp")
	if [ $? -eq 1 ]; then
		break
	fi
done

hyprctl dispatch workspace "$mp" -q
exit 0
