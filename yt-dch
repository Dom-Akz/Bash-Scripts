#!/bin/bash

# yt-dlp --dump-json "$URL" | jq '.chapters':
# return a json : { start_time, title (chapter), end_time}

# options :
# -a : downloads all chapters (skip the choice part)
# -o : audio only (the defautl will be video)
# -f : specifique location (default is Videos/ or Music/)

# get all chapter -> list the name of each one
# get the choice from user -> downloads files

JSON_DATA="/tmp/out-yt-dch.json"
# in case the user run the command with the same url
# json have the urls and for each url we store chapiters titles.
CACHE_URLS="/tmp/urls-yt-dch.json"

# this is a helper function : check if url aleady exist in CACHE_URLS
# !should not print titles!

init-files() {
	if [ ! -f "$CACHE_URLS" ]; then
		touch $CACHE_URLS 2>/dev/null
	fi
}

# take url and search in CACHE_URLS file for it
get-chapters-cache() {
	local url="$1"
	# get all urls in file and see if there is any match.
	$(jq '.url' "$CACHE_URLS" | grep -qwc "$url")
	if [ $? -eq 0 ]; then
		local data=$(
			jq --arg url "$url" 'select(.url == $url) | .titles' "$CACHE_URLS"
		)
		echo "$data"
	else
		echo ""
	fi
}

print-chapters() {
	local url="$1"
	local res=""

	# call the helper function to check if url aleadry exist :
	res=$(get-chapters-cache "$url")

	if [ ! -z "$res" ]; then
		echo -e "All chaipters\n$res " # the url already exist and we can just print it.
	else
		# get all video data and extract the title of each chapter:
		$(yt-dlp --dump-json "$url" >"$JSON_DATA")
		[[ $? -eq 1 ]] && exit 1

		# TODO : in canse there is no chapters in video:
		echo "All chapiters"
		jq -r ".chapters[].title" $JSON_DATA 2>/dev/null

		# here is the caching of urls (if url already exits just overwriter it):
		jq --arg url "$url" '{url: $url, titles: [.chapters[].title]}' \
			"$JSON_DATA" >>"$CACHE_URLS"

		rm "$JSON_DATA" # don't need the file anymore.
	fi
}

usage() {
	echo -e "usage : yt-dch [options] url"
	echo -e "\t-h : display help"
	echo -e "\t-a : downloads all chapters"
	echo -e "\t-o : downloads audio file"
	echo -e "\t-f : output location"
}

# get the user input return the number of chapters you want to download
get-wtd() {
	local i=3
	local f=false # flag
	local t_files=$(cat /tmp/urls-yt-dch.json | jq --raw-output0 '.titles' | wc -l)

	while [[ $i -ne 0 ]]; do
		read -p "Chose a number(1-$t_files):" res
		if [ $res -le $t_files ] && [ $res -gt 0 ]; then
			f=true # the input given is valid
			break
		fi
		i=$((i - 1))
	done
	if ! $f; then
		echo "Error: Invalid chapters number"
		exit 1
	else
		echo "$res"
	fi
}

main() {
	download_all=false
	audio=false
	location=false
	path=""
	init-files # create cache url file

	while getopts "aof:h" opt; do
		case "$opt" in
		a)
			download_all=true
			;;
		o)
			audio=true
			;;
		f)
			location=true
			path="$OPTARG""/%(title)s.%(ext)s"
			;;
		h)
			usage
			exit 0
			;;
		\*)
			echo "invalid option -$opt"
			usage
			exit 1
			;;
		esac
	done

	shift $((OPTIND - 1))
	if [ -z "$1" ]; then
		echo -e "no url was given\nrun -h to see the usage"
		exit 1
	fi

	local url="$1"
	local nb_files=0 # how much chapters to downloads
	local ad_arg=""  # audio arguments
	local w_td=""
	print-chapters $url # exit 1

	if ! $download_all; then
		nb_files=$(get-wtd)                   # exit 1
		w_td="--download-sections 0-$nb_file" # this dose not work
	fi

	if $audio; then
		ad_arg="-x --audio-format mp3 --audio-quality 0"
	fi

	# this where the downloads happens

	yt-dlp --split-chapters $w_td $ad_arg $path $url # exit 1

	exit 0
}

main "$@"
