#!/bin/bash

DEFAULT_DIR="$HOME/.local/bin/wall-log/"
TD_LOG="$HOME/.local/bin/wall-log/chwall-$(date +%d-%m-%y).log"

## take the default dir

tot_f=$(find "$DEFAULT_DIR" -type f | wc -l)

if [ $tot_f -eq 0 ] || [ $tot_f -eq 1 ]; then
	echo "the directory $DEFAULT_DIR is empty"
	exit 0
fi

for file in $(find "$DEFAULT_DIR" -type f); do
	if [ "$file" != "$TD_LOG" ]; then # skip tody log file
		rm $file
	fi

done

echo "all file was removed"
exit 0
