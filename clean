#!/bin/bash

DEFAULT_DIR="$HOME/.local/bin/wall-log/"

#if [ -z "$1" ];then
#   echo "no directory given!"
#elif [ -d "$1" ];then

## take the default dir

if [ $(find "$DEFAULT_DIR" -type f | wc -l) -eq 0 ]; then
	echo "the directory $DEFAULT_DIR is empty"
	exit 0
fi

for file in $(find "$DEFAULT_DIR" -type f); do
	rm "$file"
done

echo "all file was removed"
exit 0
