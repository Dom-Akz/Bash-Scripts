[Unit]
Description=Start Voice Recording 
Wants=wds.service

[Service]
ExecStartPre=/usr/bin/mkdir -p /home/soufiane/Music/Record 
ExecStartPre=/usr/bin/notify-send -u critical "Error" "Hyprland service failed"
ExecStart=/usr/bin/arecord -D default -f cd -t wav --max-file-time 30 /home/soufiane/Music/Record/voice.wav

[Install]
WantedBy=default.target

