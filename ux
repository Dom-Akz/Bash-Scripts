#!/bin/bash

# uv index of the current time
# $1 is to specify the hour of the day

if [ -z "$1" ]; then
	curl -s "https://api.openuv.io/api/v1/uv?lat=33.5333&lng=-7.5833" \
		-H "x-access-token: openuv-7c1arrmc4m8jk3-io" |
		jq '.result | {uv: .uv, max_uv: .uv_max, max_time: .uv_max_time}'
else
	curl -s "https://api.openuv.io/api/v1/uv?lat=33.5333&lng=-7.5833&dt=$(date -u +%Y-%m-%d)T$1:00:00Z" \
		-H "x-access-token: openuv-7c1arrmc4m8jk3-io" |
		jq '.result | {uv: .uv, max_uv: .uv_max, max_time: .uv_max_time}'
fi
